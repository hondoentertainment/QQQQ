{
  "name": "qqqq-component-tracker",
  "version": "1.0.0",
  "description": "Live components and monthly allocations of QQQQ (Invesco QQQ Trust / Nasdaq-100).",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "REFRESH_MINUTES=30 node --env-file-if-exists=.env server.js",
    "refresh": "node --env-file-if-exists=.env scripts/fetch-holdings.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test e2e/*.test.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "vercel": "^54.3.0"
  },
  "overrides": {
    "@vercel/fun": "1.3.6",
    "js-yaml": "4.3.2",
    "smol-toml": "1.9.1",
    "@vercel/python-analysis": {
      "minimatch": "10.2.6"
    },
    "@vercel/node": {
      "path-to-regexp": "6.3.0",
      "undici": "6.29.1"
    },
    "@vercel/remix-builder": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/backends": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/express": {
      "path-to-regexp": "8.4.2"
    },
    "@vercel/hono": {
      "path-to-regexp": "8.4.2"
    }
  }
}
